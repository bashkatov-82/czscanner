[app]
title = Crypto Zone Scanner
package.name = czscanner
package.domain = org.cryptozone
source.dir = .
source.include_exts = py,png,ico,txt
requirements = python3,kivy,requests,numpy,pandas
android.permissions = INTERNET
android.archs = arm64-v8a
fullscreen = 0
orientation = portrait
version = 1.0.0

[buildozer]
log_level = 2
warn_on_root = 1
